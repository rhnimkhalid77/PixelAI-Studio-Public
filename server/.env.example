# Copy this file to server/.env on the inference host. Never commit server/.env.
# Generate a random secret of at least 32 characters, e.g. with: openssl rand -hex 32
PIXELAI_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Default starter model. Review and accept its model license before use.
PIXELAI_MODEL_ID=stabilityai/sdxl-turbo
